# =============================================================================
# MCQ Interview Drill — environment configuration
# Copy this file to `.env.local` (gitignored) and adjust as needed.
# Next.js loads `.env.local` automatically; never commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Embedded opencode serve (local development)
# -----------------------------------------------------------------------------
# Set to "false" to disable the embedded opencode serve process and use the
# direct API paths below instead. Required for Vercel/serverless deployments.
# USE_EMBEDDED_OPENCODE=false

# Port for the embedded `opencode serve` that the @opencode-ai/sdk drives.
# Choose a port that is free on this machine. (default: 4097)
OPENCODE_SDK_PORT=4097

# Silence timeout in ms before the generator aborts a stalled run.
# (default: 360000 -> 6 minutes)
MCQ_GENERATOR_TIMEOUT_MS=360000

# Optional: explicit path to the opencode binary used to boot the embedded
# server. Only needed if `opencode` is not on PATH. (default: `opencode`)
# OPENCODE_BIN=/usr/local/bin/opencode

# -----------------------------------------------------------------------------
# Direct API — OpenCode Zen (primary remote path, free)
# -----------------------------------------------------------------------------
# When USE_EMBEDDED_OPENCODE=false, 50% of technologies are generated via
# OpenCode Zen using the free big-pickle model (model knowledge only, no web
# search). Get your key at https://opencode.ai/auth
# OPENCODE_ZEN_API_KEY=your-opencode-zen-api-key

# -----------------------------------------------------------------------------
# Direct API — OpenRouter (secondary remote path, free + web search)
# -----------------------------------------------------------------------------
# When USE_EMBEDDED_OPENCODE=false, the other 50% of technologies are generated
# via OpenRouter using a free model with web search. Get your key at
# https://openrouter.ai/keys
# OPENROUTER_API_KEY=your-openrouter-api-key
# Optional: override the default free model (default: openrouter/free)
# OPENROUTER_MODEL=openrouter/free

# -----------------------------------------------------------------------------
# Direct API — NVIDIA (alternative remote path; OpenAI-compatible endpoint)
# -----------------------------------------------------------------------------
# When USE_EMBEDDED_OPENCODE=false and NVIDIA_ONLY=true, ALL technologies are
# generated via NVIDIA Build's OpenAI-compatible API using the Nemotron model.
# Get your (nvapi-...) key at https://build.nvidia.com (Settings -> API Keys).
# NVIDIA_ONLY=true
# NVIDIA_API_KEY=nvapi-...
# Optional: override the default model (default: nvidia/nemotron-3.5-lightning-30b-a3b)
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# -----------------------------------------------------------------------------
# Legacy / direct provider keys (only needed if you switch agent models)
# -----------------------------------------------------------------------------
# The `mcq-generator` agent uses model `opencode/big-pickle`, which
# authenticates through YOUR opencode account (run `opencode auth login` on
# this machine). No key is required locally for that model.
#
# If you switch the agent to a direct provider model, provide that provider's
# key via its standard env var on the RUNNING machine (never commit it):
#   ANTHROPIC_API_KEY=sk-ant-...
#   OPENAI_API_KEY=sk-...
#   GEMINI_API_KEY=...
# For a remote deployment, set these as secret env vars on the server/host.
