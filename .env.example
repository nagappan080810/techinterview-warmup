# =============================================================================
# MCQ Interview Drill — environment configuration
# Copy this file to `.env.local` (gitignored) and adjust as needed.
# Next.js loads `.env.local` automatically; never commit real secrets.
# =============================================================================

# Port for the embedded `opencode serve` that the @opencode-ai/sdk drives.
# Choose a port that is free on this machine. (default: 4097)
OPENCODE_SDK_PORT=4097

# Silence timeout in ms before the generator aborts a stalled run.
# (default: 360000 -> 6 minutes)
MCQ_GENERATOR_TIMEOUT_MS=360000

# Optional: explicit path to the opencode binary used to boot the embedded
# server. Only needed if `opencode` is not on PATH. (default: `opencode`)
# OPENCODE_BIN=/usr/local/bin/opencode
# OPENAI_API_KEY=sk-rS7KOTii2UqNP3xYWEONzMB33CqjkumGgtTBSGKyAGdKccumrEBQP2qIS8ZMl68J
# -----------------------------------------------------------------------------
# Model authentication
# -----------------------------------------------------------------------------
# The `mcq-generator` agent uses model `opencode/big-pickle`, which
# authenticates through YOUR opencode account (run `opencode auth login` on
# this machine). No key is required locally for that model.
#
# If you switch the agent to a direct provider model, provide that provider's
# key via its standard env var on the RUNNING machine (never commit it):
#   ANTHROPIC_API_KEY=sk-ant-...
#   OPENAI_API_KEY=sk-...
#   GEMINI_API_KEY=...
# For a remote deployment, set these as secret env vars on the server/host.
